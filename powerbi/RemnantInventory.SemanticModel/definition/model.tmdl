model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "fRemnants", "dMaterial", "dMachine", "dLocation", "dCalendar"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fRemnants
ref table dMaterial
ref table dMachine
ref table dLocation
ref table dCalendar
